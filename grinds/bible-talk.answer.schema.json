{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bible Talk Answer 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "words"],
  "properties": {
    "answer": {
      "description": "The reply to what he said, in short plain English; or the one-sentence refusal for anything outside the Bible.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "question": {
      "description": "What he just said, put into clean written words: the capitals and punctuation it needs (question marks, full stops), the ums, uhs, repeated words and dropped starts taken out, the meaning and his own words kept. Never an answer or an explanation; unchanged when it was clean already. At most the length of what he said.",
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "words": {
      "description": "The Greek words the answer speaks about, each with its lemma and a short note that includes its parsing. Empty when the answer is about no particular word.",
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["greek", "lemma", "note"],
        "properties": {
          "greek": { "description": "The word as it stands in the text.", "type": "string", "minLength": 1, "maxLength": 80 },
          "lemma": { "description": "Its dictionary form.", "type": "string", "minLength": 1, "maxLength": 80 },
          "note": { "description": "Its parsing and what it does here, in plain words.", "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "syllables": {
      "description": "Only when the question asked how to sound a word out (its focus kind is sound): the word's syllables in Greek letters, in order, each one short enough to say alone; for a Hebrew word (focus language he), in the pointed Hebrew letters. Leave it out otherwise.",
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "transliteration": {
      "description": "Only for a Hebrew word's sound question (focus kind sound and language he): how each entry of syllables sounds, in plain Latin letters with no special marks, in the same order and the same number, the stressed syllable in capitals (TSE, dek). Leave it out otherwise.",
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 }
    },
    "words_to_add": {
      "description": "Only when he asked to put words on his words-to-learn list ('add σάρξ to my words'): the dictionary form of each word, in Greek letters. Leave it out otherwise.",
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "study_way_line": {
      "description": "Only in a quiz (mode quiz), and only when he asked for a lasting change to how he is quizzed ('shorter quizzes', 'skip the map', 'more grammar'): one short line, in his terms, that states the change as a standing instruction for later quizzes. The app shows it with a Keep this button and keeps it only if he taps; it is not kept otherwise. Leave it out for anything that is only for today.",
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "feedback_offer": {
      "description": "Only when he asked for something Lampas does not do (to work with another app, a setting it does not have, a change to a screen): the one-line summary of his ask, in plain English and his terms, at most 200 characters. The app shows it as a Send this to the makers button under the answer and sends nothing unless he taps. Never a promise that the change will happen. Leave it out for anything else.",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": { "summary": { "description": "One line saying what he wants.", "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "form_values": {
      "description": "Only while he is being helped to fill in a form (`form` in the request): the values to put in its fields from what he just said, each the field's `name` and the field's whole new value. Only text and link fields, never pictures; never a field the form does not list. Leave it out when his words fill nothing.",
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value"],
        "properties": {
          "field": { "description": "The `name` of one field of `form`.", "type": "string", "minLength": 1, "maxLength": 30 },
          "value": { "description": "The whole new value of the field.", "type": "string", "minLength": 1, "maxLength": 1200 }
        }
      }
    },
    "form_ask": {
      "description": "Only while he is being helped to fill in a form: the `name` of the field the question in `answer` is about (a pictures field when you ask for a photo). Leave it out when there is nothing more to ask, which is when every required field is filled and he has nothing to add.",
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "links": {
      "description": "Links the app turns into buttons that open a word or a verse in the reader's own study resources (lexicons, a Bible); he sees only the ones he has switched on. At most three. Leave it out when no lexicon or verse would help him.",
      "type": "array",
      "maxItems": 3,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "lemma"],
            "properties": {
              "kind": { "const": "word" },
              "lemma": {
                "description": "The word's dictionary form, in Greek letters, with its accents and breathings.",
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reference"],
            "properties": {
              "kind": { "const": "verse" },
              "reference": {
                "description": "A verse of any book of the Bible, Old Testament or New, such as Romans 8:31, 1 John 1:9 or Isaiah 53:5.",
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            }
          }
        ]
      }
    },
    "settings_changes": {
      "description": "The settings he asked to change, each applied at once by the app. Only when he asked for the change in words, never on your own; only the keys and values the instructions list; leave it out when he asked for no change.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "theme" }, "value": { "type": "string", "enum": ["phone", "light", "dark"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "textSize" }, "value": { "type": "string", "enum": ["small", "normal", "large", "largest"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "layout" }, "value": { "type": "string", "enum": ["verse", "paragraph"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "sectionHeadings" }, "value": { "type": "string", "enum": ["on", "off"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "readSpan" }, "value": { "type": "string", "enum": ["verse", "passage", "chapter", "book"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "readTutor" }, "value": { "type": "string", "enum": ["on", "off"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "hebrewDepth" }, "value": { "type": "string", "enum": ["transliteration", "both", "full"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "tips" }, "value": { "type": "string", "enum": ["on", "off"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "weave" }, "value": { "type": "string", "enum": ["off", "solid", "solid+learning"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "weaveGrammar" }, "value": { "type": "string", "enum": ["any", "solid", "solid+frontier"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "newWordsADay" }, "value": { "type": "string", "enum": ["0", "3", "5", "10"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "pickerGrammar" }, "value": { "type": "string", "enum": ["solid", "frontier"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "grammarMove" }, "value": { "type": "string", "enum": ["ask", "auto", "off"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "goal" }, "value": { "type": "string", "maxLength": 80 } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "grammarApproach" }, "value": { "type": "string", "enum": ["bma-tutor", "ladder"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "englishVoice" }, "value": { "type": "string", "enum": ["default"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "greekVoice" }, "value": { "type": "string", "enum": ["default"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "englishRate" }, "value": { "type": "number", "minimum": 0.5, "maximum": 1.5 } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "greekRate" }, "value": { "type": "number", "minimum": 0.5, "maximum": 1.5 } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "greekPronunciation" }, "value": { "type": "string", "enum": ["modern"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "resource.strongs" }, "value": { "type": "string", "enum": ["on", "off"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "resource.logos" }, "value": { "type": "string", "enum": ["on", "off"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "resource.accordance" }, "value": { "type": "string", "enum": ["on", "off"] } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": { "key": { "const": "logosBible" }, "value": { "type": "string", "maxLength": 80 } }
          }
        ]
      }
    }
  }
}
