{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verse Ask Answer 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "words"],
  "properties": {
    "answer": {
      "description": "The reply to his question, in short plain English, at most 120 words.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "question": {
      "description": "What he just said, put into clean written words: the capitals and punctuation it needs (question marks, full stops), the ums, uhs, repeated words and dropped starts taken out, the meaning and his own words kept. Never an answer or an explanation; unchanged when it was clean already. At most the length of what he said.",
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "settings_changes": {
      "description": "Only when he asked in words to switch how Ask the tutor opens: askBy to typing (\"let me type\") or to speaking (\"switch back to speaking\"). The app applies it at once; say in `answer` what you did. Leave it out otherwise, and never change any other setting.",
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": { "key": { "const": "askBy" }, "value": { "type": "string", "enum": ["speaking", "typing"] } }
      }
    },
    "bridge": {
      "description": "Only when the request carried `missing_foundations` and his question truly rests on them (see the instructions, 'When he is not ready for the question'): up to three of the ideas listed there that he lacks, the most important first (`direct` ones first), the idea to start with and one plain line why it comes first. The app shows 'Take me there: <title>' and opens that idea's sheet on his tap or his yes; it takes the start from the list, not from here. Never for an idea outside the list, never without `missing_foundations`, one bridge per answer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["missing", "next", "why"],
      "properties": {
        "missing": {
          "description": "The ideas he lacks for this question, most important first: one to three ids from `missing_foundations.ideas`.",
